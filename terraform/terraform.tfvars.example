# Example terraform.tfvars configuration file
# Copy this file to terraform.tfvars and customize the values

# General Configuration
project_name = "deaf-creator-platform"
environment  = "production"

# AWS Configuration
aws_region = "us-east-1"

# Provider API Tokens (Store these securely, preferably in environment variables)
# cloudflare_api_token = "your-cloudflare-api-token"
# vercel_api_token     = "your-vercel-api-token"
# github_token         = "your-github-token"

# Frontend Configuration
frontend_hosting_provider = "vercel"
vercel_project_name      = "deaf-creator-platform"
vercel_framework         = "nextjs"
vercel_build_command     = "npm run build"
vercel_output_directory  = ".next"

# Alternative: S3 Frontend Hosting
# frontend_hosting_provider = "s3"
# s3_frontend_bucket_name = "deaf-creator-platform-frontend"
# cloudfront_enabled = true

# Backend Configuration
backend_hosting_provider = "lambda"
lambda_runtime          = "nodejs20.x"
lambda_memory_size      = 1024
lambda_timeout          = 60

# Alternative: EC2 Backend
# backend_hosting_provider = "ec2"
# ec2_instance_type = "t3.small"
# ec2_ami_id = "ami-xxxxxxxxx"

# Database Configuration
database_provider         = "neon"
postgres_version         = "15"
database_name            = "deaf_creator_platform"
neon_project_name        = "deaf-creator-platform"
neon_region              = "aws-us-east-2"

# Alternative: RDS Database
# database_provider = "rds"
# postgres_instance_class = "db.t4g.micro"
# database_allocated_storage = 20
# database_multi_az = false
# database_backup_retention = 7

# Storage Configuration
storage_provider     = "cloudflare_r2"
cloudflare_account_id = "your-cloudflare-account-id"
r2_bucket_name       = "deaf-creator-platform-uploads"

# Alternative: S3 Storage
# storage_provider = "s3"
# s3_storage_bucket_name = "deaf-creator-platform-storage"
# s3_versioning_enabled = true

# CORS Configuration
cors_allowed_origins = ["https://creators.example.com"]
cors_allowed_methods = ["GET", "PUT", "POST", "DELETE"]

# DNS Configuration
dns_provider     = "cloudflare"
domain_name      = "example.com"
subdomain_prefix = "creators"
cloudflare_zone_id = "your-cloudflare-zone-id"
cdn_enabled      = true

# Alternative: Route53
# dns_provider = "route53"
# route53_zone_id = "your-route53-zone-id"

# Secrets Management
secrets_provider = "aws_secrets_manager"
secrets_to_manage = [
  "database_url",
  "nextauth_secret",
  "stripe_secret_key",
  "pinksync_api_key",
  "cloudflare_access_key"
]
secrets_recovery_window = 30

# Monitoring
monitoring_enabled  = true
log_retention_days = 30
alarm_email        = "ops@example.com"

# CI/CD Configuration
cicd_enabled         = true
github_repository    = "v0-deaf-creator-platform-multi-tenants"
github_owner         = "pinkycollie"
cicd_workflow_triggers = ["push", "pull_request"]

# Common Tags
tags = {
  Project     = "deaf-creator-platform"
  Environment = "production"
  ManagedBy   = "Terraform"
  Team        = "Platform Engineering"
}
